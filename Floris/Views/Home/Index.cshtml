@model HomeViewModel
@{
    ViewData["Title"] = "Доставка цветов";
    var ru = CultureInfo.GetCultureInfo("ru-RU");
}

<section class="hero">
    <div class="container">
        <div class="hero-content">
            <h2 class="hero-title">Цветы, которые говорят за вас</h2>
            <p class="hero-subtitle">Свежие букеты с доставкой за 2 часа. Выберите из готовых композиций или соберите свой уникальный букет.</p>
            <div class="hero-actions">
                <a asp-action="Index" asp-fragment="catalog" class="btn btn-primary btn-large">Выбрать букет</a>
            </div>
        </div>
    </div>
</section>

<section class="city-selector">
    <div class="container">
        <div class="city-selector-content">
            <span>Ваш город:</span>
            <select class="city-select" disabled title="Выбор города и магазина заработает на следующем этапе">
                @foreach (var city in Model.Cities)
                {
                    <option value="@city.Id">@city.Name</option>
                }
            </select>
        </div>
    </div>
</section>

<section id="catalog" class="catalog">
    <div class="container">
        <h2 class="section-title">Популярные букеты</h2>

        @if (Model.PopularBouquets.Count == 0)
        {
            <p class="muted text-center">Пока в каталоге нет букетов.</p>
        }
        else
        {
            <div class="catalog-grid">
                @foreach (var product in Model.PopularBouquets)
                {
                    <div class="product-card">
                        <div class="product-image">
                            <img src="@(product.PhotoUrl ?? Url.Content("~/images/placeholder.svg"))" alt="@product.Name">
                        </div>
                        <div class="product-info">
                            <h3 class="product-title">@product.Name</h3>
                            <p class="product-description">@product.Description</p>
                            <div class="product-footer">
                                <span class="product-price">@(product.BasePrice.ToString("N0", ru)) ₽</span>
                                <button class="btn btn-primary btn-small" disabled title="Корзина появится на следующих этапах">В корзину</button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

<section class="features">
    <div class="container">
        <h2 class="section-title">Почему выбирают Floris</h2>
        <div class="features-grid">
            <div class="feature-card">
                <div class="feature-icon">🚀</div>
                <h3>Быстрая доставка</h3>
                <p>Доставим букет за 2 часа в любую точку города</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">📸</div>
                <h3>Фото-отчёт</h3>
                <p>Пришлём фото готового букета перед доставкой</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">🎨</div>
                <h3>Свой букет</h3>
                <p>Соберите уникальную композицию в конструкторе</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">💝</div>
                <h3>Гарантия свежести</h3>
                <p>Только свежие цветы, проверенные флористами</p>
            </div>
        </div>
    </div>
</section>
