@model HomeViewModel
@{
    ViewData["Title"] = "Доставка цветов";
}

<section class="hero">
    <div class="container">
        <div class="hero-content">
            <h2 class="hero-title">Цветы, которые говорят за вас</h2>
            <p class="hero-subtitle">Свежие букеты с доставкой за 2 часа. Выберите из готовых композиций или соберите свой уникальный букет.</p>
            <div class="hero-actions">
                <a asp-controller="Catalog" asp-action="Index" class="btn btn-primary btn-large">Выбрать букет</a>
            </div>
        </div>
    </div>
</section>

<section class="city-selector">
    <div class="container">
        <div class="city-selector-content">
            @if (Model.SelectedStore != null)
            {
                <span>Ваш магазин: <strong>@Model.SelectedStore.City.Name, @Model.SelectedStore.Name</strong></span>
                <a asp-controller="Store" asp-action="Select" class="btn btn-outline btn-small">Сменить</a>
            }
            else
            {
                <span>Выберите магазин, чтобы увидеть наличие и цены.</span>
                <a asp-controller="Store" asp-action="Select" class="btn btn-primary btn-small">Выбрать магазин</a>
            }
        </div>
    </div>
</section>

<section id="catalog" class="catalog">
    <div class="container">
        <h2 class="section-title">Популярные букеты</h2>

        @if (Model.PopularBouquets.Count == 0)
        {
            <p class="muted text-center">Пока в каталоге нет букетов.</p>
        }
        else
        {
            <div class="catalog-grid">
                @foreach (var item in Model.PopularBouquets)
                {
                    <partial name="_ProductCard" model="item" />
                }
            </div>
            <div class="catalog-actions">
                <a asp-controller="Catalog" asp-action="Index" class="btn btn-outline">Весь каталог</a>
            </div>
        }
    </div>
</section>

<section class="features">
    <div class="container">
        <h2 class="section-title">Почему выбирают Floris</h2>
        <div class="features-grid">
            <div class="feature-card">
                <div class="feature-icon">🚀</div>
                <h3>Быстрая доставка</h3>
                <p>Доставим букет за 2 часа в любую точку города</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">📸</div>
                <h3>Фото-отчёт</h3>
                <p>Пришлём фото готового букета перед доставкой</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">🎨</div>
                <h3>Свой букет</h3>
                <p>Соберите уникальную композицию в конструкторе</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">💝</div>
                <h3>Гарантия свежести</h3>
                <p>Только свежие цветы, проверенные флористами</p>
            </div>
        </div>
    </div>
</section>
