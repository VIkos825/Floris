@model StoreSelectViewModel
@{
    ViewData["Title"] = "Выбор магазина";
}

<section class="page">
    <div class="container">
        <h2 class="section-title">Выберите магазин</h2>
        <p class="text-center muted">Наличие и цены зависят от магазина.</p>

        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-error">@error</div>
        }

        @if (Model.Cities.Count == 0)
        {
            <p class="text-center">Магазинов пока нет.</p>
        }

        @foreach (var city in Model.Cities)
        {
            <div class="city-block">
                <h3 class="city-title">@city.Name</h3>
                <div class="store-list">
                    @foreach (var store in city.Stores)
                    {
                        var isSelected = store.Id == Model.SelectedStoreId;
                        <div class="store-card @(isSelected ? "store-card-selected" : null)">
                            <div class="store-card-info">
                                <h4>@store.Name</h4>
                                <p>@store.Address</p>
                                @if (!string.IsNullOrEmpty(store.Phone))
                                {
                                    <p class="muted-small">@store.Phone</p>
                                }
                            </div>
                            <form method="post" asp-controller="Store" asp-action="Select">
                                <input type="hidden" name="storeId" value="@store.Id" />
                                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                                <button type="submit" class="btn btn-primary btn-small">@(isSelected ? "Выбран" : "Выбрать")</button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</section>
